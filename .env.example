# Copie este archivo como .env en la raíz del repositorio. Nunca versione .env.
# Docker Compose lee estas variables al ejecutar `docker compose up`.

# Entorno de ejecución.
APP_ENV=local
# Zona horaria de los contenedores (el día operativo depende de ella).
TZ=America/Bogota

# --- Base de datos PostgreSQL ---
POSTGRES_DB=parkingspot
POSTGRES_USER=parkingspot
# Cambie esta contraseña en su .env local.
POSTGRES_PASSWORD=cambiar_esta_clave
# Puerto publicado en el equipo anfitrión.
DB_PORT=5432

# --- Backend ---
# Puerto HTTP publicado del backend (valor por defecto: 8080).
SERVER_PORT=8080
# Origen permitido por CORS (URL del frontend).
FRONTEND_ORIGIN=http://localhost:5173

# --- Frontend ---
# Puerto publicado del frontend.
FRONTEND_PORT=5173
# URL del backend que usa el navegador. Se fija al construir la imagen.
VITE_API_BASE_URL=http://localhost:8080

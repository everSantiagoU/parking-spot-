# Variables del backend cuando se ejecuta fuera de Docker (mvn spring-boot:run).
# Spring Boot no lee este archivo: exporte las variables en la terminal o en el IDE.
# Puerto HTTP del backend (valor por defecto: 8080).
SERVER_PORT=8080
# Origen permitido para el frontend durante desarrollo local.
FRONTEND_ORIGIN=http://localhost:5173
# Conexión a PostgreSQL (la base de docker compose publica el puerto 5432).
DB_URL=jdbc:postgresql://localhost:5432/parkingspot
DB_USERNAME=parkingspot
DB_PASSWORD=cambiar_esta_clave
# Zona horaria usada por la JVM y por Hibernate.
TZ=America/Bogota
